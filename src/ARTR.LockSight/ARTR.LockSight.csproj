<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ARTR.LockSight</RootNamespace>
    <AssemblyName>ARTR.LockSight</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>artr-locksight</ToolCommandName>
    <PackageId>ARTR.LockSight</PackageId>
    <Version>1.1.0</Version>
    <Authors>Artur Bobb (Chookees)</Authors>
    <Description>Local doctor/diagnostics for NuGet packages.lock.json drift, NU1004, and RestoreLockedMode failures.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Chookees/ARTR.LockSight</RepositoryUrl>
    <PackageTags>nuget;lockfile;diagnostics;restore;NU1004;ARTR</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="6.14.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="ARTR.LockSight.Tests" />
  </ItemGroup>

</Project>
